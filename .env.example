# AS CHAVES DO PROJETO MORAM EM core/.env, NÃO AQUI.
#
#   cp .env.example core/.env
#
# Um arquivo só, lido pelos três jeitos de executar: o núcleo direto na máquina
# (pelo pydantic-settings), o adaptador de Telegram, e o docker compose. Já
# houve dois arquivos concorrentes aqui, e o resultado foi um container
# respondendo com os textos padrão enquanto a chave do Gemini estava no outro.
#
# NADA AQUI É OBRIGATÓRIO. Sem nenhum arquivo o sistema sobe e funciona: ele
# responde com os textos escritos no flows.json e roteia normalmente. As chaves
# só ligam recursos extras.
#
# Os arquivos .env estão no .gitignore e não vão para o repositório.
#
# As três últimas seções (portas, tempos e modelo) são exceção: elas ajustam o
# compose, não o núcleo, então valem num .env AQUI na raiz. Na prática quase
# ninguém precisa mexer nelas.


# ---------------------------------------------------------------- IA generativa
# Sem a chave, o assistente usa os textos padrão do flows.json. O roteamento, o
# destino e o protocolo são idênticos nos dois casos: o modelo é redator, nunca
# decisor. Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# GEMINI_MODEL=gemini-flash-lite-latest
# LLM_TIMEOUT_MS=8000


# ---------------------------------------------------------------- canal Telegram
# Só é usado com `docker compose --profile telegram up`. Sem o token, o
# adaptador avisa e encerra sem erro. O token vem do @BotFather no Telegram.
TELEGRAM_BOT_TOKEN=

# Um bot de Telegram é público: quem descobrir o nome dele consegue conversar e
# gastar sua cota do Gemini. Liste aqui os chat_id liberados, separados por
# vírgula, para fechar o bot. Vazio libera todos.
# Para descobrir o seu: mande uma mensagem com isto vazio e leia o número no log.
TELEGRAM_ALLOWED_CHATS=

# TELEGRAM_POLL_TIMEOUT_S=30


# ---------------------------------------------------------------- portas e tempos
# Mude se a 3000 já estiver ocupada na sua máquina.
# WEB_PORT=3000

# Só vale em `make dev`: publica o núcleo para bater nele com curl direto.
# CORE_PORT=8000

# Quanto o site espera pelo núcleo antes de responder pelas regras locais.
# CORE_TIMEOUT_MS=2500


# ---------------------------------------------------------------- modelo
# Trocar exige refazer a calibração dos limiares do flows.json: os números de
# confiança não são comparáveis entre modelos diferentes.
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
